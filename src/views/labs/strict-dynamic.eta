<% layout('/lab-layout') %>
<div class="creature-row">
  <%~ include('/components/creature', { suffix: 'loader', label: 'Loader script', controller: true, mode: 'strict-dynamic' }) %>
  <%~ include('/components/creature', { suffix: 'injected', label: 'Injected script (/lab-assets/scripts/sdk.js)' }) %>
</div>

<script nonce="<%= it.nonce %>"><%~ it.loaderScript %></script>

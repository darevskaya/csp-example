<% const sfx = it.suffix ? '-' + it.suffix : ''; %>
<div class="creature-panel card" id="creature-panel<%= sfx %>"<%~ it.controller ? ' data-controller="creature"' : '' %><%~ it.mode ? ' data-mode="' + it.mode + '"' : '' %>>
  <div class="card-header"><%= it.label %></div>
  <div class="card-body">
    <div class="creature-stage">
      <div class="creature" id="creature<%= sfx %>">( ._.)
      </div>
      <div class="creature-speech" id="creature-speech<%= sfx %>"></div>
    </div>
    <% if (it.slot) { %><%~ it.slot %><% } %>
  </div>
</div>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%~ it.viteHmrScript %>
  <% if (it.mainCss && it.mainCss.length > 0) { %>
    <% for (const href of it.mainCss) { %>
  <link rel="stylesheet" href="<%= href %>">
    <% } %>
  <% } %>
</head>
<body class="lab-body">
  <script<% if (it.nonce) { %> nonce="<%= it.nonce %>"<% } %>><%~ it.labEarlyInitScript %></script>
  <main class="lab-main"><%~ it.body %></main>
  <script type="module" src="<%= it.mainJs %>"<% if (it.nonce) { %> nonce="<%= it.nonce %>"<% } %>></script>
</body>
</html>

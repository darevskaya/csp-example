<% layout('/layout') %>
<a class="back" href="/">← back to examples</a>

<div class="example-header">
  <h1 class="example-title">script-src hash</h1>
  <p class="example-desc"><%~ it.explanation %></p>
</div>

<%~ include('/components/mode-toggle', { tabs: [
  { label: 'Script without matching hash', href: '/examples/inline-script/no-hash', state: it.withHash ? '' : 'unsafe' },
  { label: 'Script with matching hash', href: '/examples/inline-script/hash', state: it.withHash ? 'safe' : '' }
] }) %>

<div class="info-box card">
  <div class="card-header">Response header (same on both pages)</div>
  <div class="card-body"><code class="info-code">Content-Security-Policy: <%= it.cspDisplay %></code></div>
</div>

<div class="script-box card">
  <div class="card-header">Inline script in page source</div>
  <div class="card-body">
    <pre class="script-pre"><code class="script-code">&lt;script&gt;<%= it.activeScript %>&lt;/script&gt;</code></pre>
    <div class="hash-note">
      <code class="script-code script-comment">// Header allows hash: <span class="nonce-token"><%= it.scriptHash %></span></code>
      <% if (!it.withHash) { %>
        <br><code class="script-code script-comment">// Script hash: <span class="nonce-missing"><%= it.differentScriptHash %> ← does not match</span></code>
      <% } %>
    </div>
  </div>
</div>


<iframe class="lab-frame" src="/lab/hash/<%= it.withHash ? 'hash' : 'no-hash' %>" title="Result"></iframe>

<% if (!it.withHash) { %>
<p class="console-hint">Check the browser console to see the CSP violation error.</p>
<% } %>

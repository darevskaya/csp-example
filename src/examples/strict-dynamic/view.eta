<% layout('/views/layout') %>
<a class="back" href="/">← back to examples</a>

<div class="example-header">
  <h1 class="example-title">script-src strict-dynamic</h1>
  <p class="example-desc"><%~ it.explanation %></p>
</div>

<%~ include('/ui/components/mode-toggle/mode-toggle', { tabs: [
  { label: 'No strict-dynamic', href: '/examples/third-party/no-strict-dynamic', state: it.mode === 'no-strict-dynamic' ? 'unsafe' : '' },
  { label: 'strict-dynamic', href: '/examples/third-party/strict-dynamic', state: it.mode === 'strict-dynamic' ? 'safe' : '' }
] }) %>

<%~ include('/ui/components/csp-header-card/csp-header-card', { active: true, cspDisplay: it.cspDisplay }) %>

<div class="script-box card">
  <div class="card-header">Loader script in page source</div>
  <div class="card-body">
    <pre class="script-pre"><code class="script-code">&lt;script nonce="<span class="nonce-token"><%= it.nonce %></span>"&gt;
<%~ it.loaderDisplay %>
&lt;/script&gt;</code></pre>
  </div>
</div>

<div class="creature-row">
  <%~ include('/ui/components/creature/creature', { suffix: 'loader', label: 'Loader script', controller: true, mode: 'strict-dynamic' }) %>
  <%~ include('/ui/components/creature/creature', { suffix: 'injected', label: 'Injected script (/lab-assets/scripts/sdk.js)' }) %>
</div>

<section class="demo-surface" data-demo-surface>
  <script nonce="<%= it.nonce %>"><%~ it.loaderScript %></script>
</section>

<% if (it.mode === 'no-strict-dynamic') { %>
<p class="console-hint">Check the browser console to see the CSP violation error.</p>
<% } %>

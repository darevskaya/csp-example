<% layout('/views/layout') %>
<a class="back" href="/">← back to examples</a>

<div class="example-header">
  <h1 class="example-title">script-src hash</h1>
  <p class="example-desc"><%~ it.explanation %></p>
</div>

<%~ include('/ui/components/mode-toggle/mode-toggle', { tabs: [
  { label: 'Script without matching hash', href: '/examples/inline-script/no-hash', state: it.withHash ? '' : 'unsafe' },
  { label: 'Script with matching hash', href: '/examples/inline-script/hash', state: it.withHash ? 'safe' : '' }
] }) %>

<div class="demo-panel">
  <div class="demo-row">
    <div class="demo-row-label">Response header</div>
    <div class="demo-row-value">Content-Security-Policy: <%= it.cspDisplay %></div>
  </div>
  <div class="demo-row">
    <div class="demo-row-label">Inline script in page source</div>
    <div class="demo-row-value">
      <div>&lt;script&gt;<%= it.activeScript %>&lt;/script&gt;</div>
      <div class="hash-note">
        <code class="script-code script-comment">// Header allows hash: <span class="nonce-token"><%= it.scriptHash %></span></code>
        <% if (!it.withHash) { %>
          <br><code class="script-code script-comment">// Script hash: <span class="nonce-missing"><%= it.differentScriptHash %> ← does not match</span></code>
        <% } %>
      </div>
    </div>
  </div>
  <div class="demo-divider" data-demo-divider></div>
  <div class="demo-result" data-demo-result>
    <%~ include('/ui/components/creature/creature', { label: '' }) %>
  </div>
</div>

<section class="demo-surface" data-demo-surface>
  <script><%~ it.activeScript %></script>
</section>

<% if (!it.withHash) { %>
<p class="console-hint">Check the browser console to see the CSP violation error.</p>
<% } %>

<% layout('../layout') %>
<a class="back" href="/">← back to examples</a>

<div class="example-header">
  <h1 class="example-title">script-src strict-dynamic</h1>
  <p class="example-desc"><%~ it.explanation %></p>
</div>

<div class="row">
  <div class="csp-toggle">
    <a class="toggle-tab<%~ it.mode === 'no-strict-dynamic' ? ' active-unsafe' : '' %>" href="/examples/third-party/no-strict-dynamic">No strict-dynamic</a>
    <a class="toggle-tab<%~ it.mode === 'strict-dynamic' ? ' active-safe' : '' %>" href="/examples/third-party/strict-dynamic">strict-dynamic</a>
  </div>
</div>

<div class="info-box card">
  <div class="card-header">Response header</div>
  <div class="card-body"><code class="info-code">Content-Security-Policy: <%= it.cspDisplay %></code></div>
</div>

<div class="script-box card">
  <div class="card-header">Loader script in page source</div>
  <div class="card-body">
    <pre class="script-pre"><code class="script-code">&lt;script nonce="<span class="nonce-token"><%= it.nonce %></span>"&gt;
<%~ it.loaderDisplay %>
&lt;/script&gt;</code></pre>
    <div class="hash-note"><code class="script-code script-comment">// dynamically injects /javascripts/sdk.js</code></div>
  </div>
</div>

<div class="creature-row">
  <div class="creature-panel card" id="creature-panel-loader">
    <div class="card-header">Loader script</div>
    <div class="card-body">
      <div class="creature-stage">
        <div class="creature" id="creature-loader">( ._.)
        </div>
        <div class="creature-speech" id="creature-speech-loader"></div>
      </div>
    </div>
  </div>
  <div class="creature-panel card" id="creature-panel-injected">
    <div class="card-header">Injected script</div>
    <div class="card-body">
      <div class="creature-stage">
        <div class="creature" id="creature-injected">( ._.)
        </div>
        <div class="creature-speech" id="creature-speech-injected"></div>
      </div>
    </div>
  </div>
</div>

<script nonce="<%= it.nonce %>" src="/javascripts/creature.js" data-mode="strict-dynamic"></script>
<script nonce="<%= it.nonce %>"><%~ it.loaderScript %></script>
